[Unit]
Description=odio Settings web UI (components, upgrade, DAC)
Documentation=https://github.com/b0bbywan/odioctl
ConditionUser=!root
ConditionUser=!@system
# No [Install]: the sockets are what gets enabled, odioctl-web.socket (port
# 8021) and/or odioctl-web-proxy.socket (odio-api's reverse proxy), and the
# first connection to either pulls this in with the fds of those running. No
# Requires= on one: odios picks the doors. --systemd-only keeps a bare
# `systemctl --user start` from binding 8021 itself; exit 2 is not retried.

[Service]
Type=simple
# ODIOCTL_ODIOS_VERSION=<tag> there points the upgrade check at an odios
# pre-release instead of the published latest one (a test odio). Both units
# read it: `odioctl web` refreshes upgrades.json on every component toggle.
# ODIOCTL_UI_URL=<url> is where the logo leads, when odio-ui is not at
# http://<host>:8018/ui.
EnvironmentFile=-/etc/default/odioctl
ExecStart=/usr/bin/odioctl web --systemd-only
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=2
