[Unit]
Description=Apply pending odios upgrade
Documentation=https://github.com/b0bbywan/odioctl
# No safe mid-run cancel: refuse manual stop rather than fake success.
RefuseManualStop=yes

[Service]
Type=oneshot
# Escalates through /etc/sudoers.d/odioctl (NOPASSWD for this exact argv);
# --progress keeps ODIO_PROGRESS events flowing to odio-api's upgrade socket.
ExecStart=/usr/bin/sudo /usr/bin/odioctl upgrade apply --progress
