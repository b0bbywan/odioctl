#!/usr/bin/make -f
export PYBUILD_NAME=odioctl

%:
	dh $@ --with python3 --buildsystem=pybuild

# Tests run in the CI test job (pytest in a uv venv); the deb build env
# doesn't carry pytest and shipping it there just for this is silly.
override_dh_auto_test:

# odios' ansible enables odio-check-upgrade.timer / odioctl-web.socket per user;
# the package must not touch user managers by itself.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

override_dh_fixperms:
	dh_fixperms
	chmod 0440 debian/odioctl/etc/sudoers.d/odioctl
