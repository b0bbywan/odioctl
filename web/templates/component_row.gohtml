<div id="row-{{.Kind}}-{{.Name}}" class="card{{if .Child}} child{{end}}">
  <div class="content"><b>{{.Label}}</b>{{if .Description}}<small>{{.Description}}</small>{{end}}{{range .Actions}}<form class="run" hx-post="components/action" hx-target="#notice" hx-swap="innerHTML"><input type="hidden" name="token" value="{{$.Token}}"><input type="hidden" name="kind" value="{{$.Kind}}"><input type="hidden" name="name" value="{{$.Name}}"><input type="hidden" name="action" value="{{.ID}}"><button class="small" type="submit">{{.Button}}</button></form>{{end}}{{range .Actions}}{{if .URL}}<small class="action"><a href="{{.URL}}" target="_blank" rel="noreferrer noopener">{{.LinkLabel}}</a>{{if .LinkNote}} ({{.LinkNote}}){{end}}</small>{{else if .Note.OK}}<small class="action"><span class="chip installed">Done</span></small>{{else if .Note.Text}}<small class="action err">{{.Button}}: {{.Note.Text}}</small>{{end}}{{end}}</div>
  <div class="meta">{{if .Required}}<span class="state lock" title="{{.Title}}" aria-label="{{.Title}}">{{template "icon-lock"}}</span>{{else}}<form hx-post="components" hx-target="#notice" hx-swap="innerHTML"><input type="hidden" name="token" value="{{.Token}}"><input type="hidden" name="kind" value="{{.Kind}}"><input type="hidden" name="name" value="{{.Name}}"><input type="hidden" name="enabled" value="{{.Enable}}"><button class="state {{.Status}}" type="submit" title="{{.Title}}" aria-label="{{.Title}}">{{if eq .Status "installed"}}<span class="rest">{{template "icon-check"}}</span><span class="act">{{template "icon-ban"}}</span>{{else if eq .Status "excluded"}}<span class="rest">{{template "icon-ban"}}</span><span class="act">{{template "icon-check"}}</span>{{else}}<span class="rest pending">{{template "icon-arrow-up"}}</span><span class="act">{{template "icon-x"}}</span>{{end}}</button></form>{{end}}</div>
</div>
