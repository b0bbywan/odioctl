<section id="components" sse-swap="components" hx-swap="outerHTML">
<h2>Components</h2>
{{if .Err}}<div class="banner err">{{.Err}}</div>{{else}}{{range .Groups}}<h3>{{.Title}}</h3>
<div class="cards">
{{with .Audioserver}}{{template "audioserver_row.gohtml" .}}{{end}}{{range .Rows}}{{template "component_row.gohtml" .}}
{{end}}</div>
{{end}}{{end}}</section>
