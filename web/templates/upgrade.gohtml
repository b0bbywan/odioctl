<section id="upgrade" sse-swap="upgrade" hx-swap="outerHTML">
<h2>Upgrade</h2>
{{if .Running}}<button class="primary" type="button" disabled>Upgrading…</button>
{{with .Progress}}<div class="progress"><progress max="100" value="{{.Percent}}">{{.Percent}}%</progress><span class="hint">{{.Percent}}%{{with .Step}} · {{.}}{{end}}</span></div>{{end}}
{{else if not .Checked}}<div class="banner warn">No upgrade check yet.</div>{{else if not .Available}}<p class="hint">{{.UpToDate}}</p>{{else}}
<ul class="pending">{{range .Items}}<li>{{.}}</li>{{end}}</ul>
{{if .CanStart}}<form hx-post="upgrade" hx-target="#notice" hx-swap="innerHTML"><input type="hidden" name="token" value="{{.Token}}"><button class="primary" type="submit">Apply now</button></form>
{{else if .Known}}<p class="hint">Upgrades run through odio-api, which cannot start one here.</p>
{{else if eq .Reach "none"}}<p class="hint">Upgrades run through odio-api, and none is configured.</p>
{{else if eq .Reach "connecting"}}<p class="hint">Reaching odio-api…</p>
{{else if eq .Reach "off"}}<p class="hint">Upgrades run through odio-api, whose upgrade backend is off.</p>
{{else}}<p class="hint">Upgrades run through odio-api, which is not answering.</p>
{{end}}{{end}}{{if .Note.Text}}<p class="hint outcome{{if .Note.Failed}} err{{end}}">Upgrade: {{.Note.Text}}</p>{{end}}</section>
